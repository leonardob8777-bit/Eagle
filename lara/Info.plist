<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Eagle uses a four-second sound sample to generate visual artwork locally, then deletes the recording.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>EagleLaunchBackground</string>
	</dict>
	<key>UIStatusBarHidden</key>
	<true/>
</dict>
</plist>
